# ==============================================================================
# INNOVISION 2026: Environment Variable Template
# Copy this file to .env.local or .env and fill in the values.
# ==============================================================================

# --- Supabase Database Direct Connection (For CLI migrations / direct SQL) ---
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# --- Supabase Auth & Application Data API (Required for web app) ---
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service role key (optional, for server-only backend jobs - keep secret)
# SUPABASE_SERVICE_ROLE_KEY=

# --- Administrator Email Allowlist (Comma-separated) ---
# Users with these emails receive automatic admin privileges
ADMIN_EMAILS=

# --- Cloudflare Turnstile Bot Defense ---
# Found in: Cloudflare Dashboard -> Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Ticket Security HMAC Salt ---
# Secret key used for signing zero-PII QR payloads
TICKET_SECURITY_SALT=
